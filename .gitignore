# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Build artifacts
dist/
build/
htmlcov/

# Ignore everything starting with a dot (files, dirs, symlinks)
.*

# Keep tracked dotfiles / dotdirs
!.gitignore
!.github/
!.pre-commit-config.yaml
!.release-please-manifest.json

# Other files
*.swp
*.swo
*.log
*.bak

# Local dev files
demo_gradio.py
run.sh

# Virtual environments (non-hidden)
env/
venv/

# Lock files (library, not application)
uv.lock
